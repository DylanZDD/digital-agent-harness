# 复制为 .env 并填入真实值,config.py 会自动加载

# OpenAI API key(provider=openai 时必填)
OPENAI_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxx

# 可选:覆盖默认 base_url(指向代理 / 兼容服务时用)
# OPENAI_BASE_URL=https://api.openai.com/v1

# 可选:覆盖默认模型
# OPENAI_MODEL=gpt-4o-mini

# ── 智谱 BigModel(Zhipu / GLM)──
# provider=zhipu 时用;也可在 config.yaml 的 provider=openai + base_url 指向智谱时复用
# ZHIPU_API_KEY=你的智谱 key
# Coding Plan base_url: https://open.bigmodel.cn/api/coding/paas/v4  (必须带 /coding/)
# 通用 API base_url:    https://open.bigmodel.cn/api/paas/v4
